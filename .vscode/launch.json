{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: gdb 调试活动文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/anzhuang/Dev-Cpp/TDM-GCC-64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "启用 gdb 美化打印（std::vector 等可读显示）",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe 生成活动文件 (Debug)"
        }
    ]
}